{
  "name": "sleepsteps-web",
  "version": "0.0.0",
  "private": true,
  "description": "Educational website for a stepped-care sleep intervention trial",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.18.0",
  "scripts": {
    "build": "node scripts/validate-content.js && eleventy",
    "predev": "npm run build",
    "dev": "eleventy --watch --quiet & wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply sleepsteps --local",
    "db:migrate:remote": "wrangler d1 migrations apply sleepsteps --remote",
    "db:migrate:preview": "wrangler d1 migrations apply sleepsteps-preview --remote --config wrangler.preview-migrations.jsonc"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.7",
    "@cloudflare/vitest-plugin": "1.4.8",
    "vitest": "4.1.12",
    "wrangler": "4.153.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "minisearch": "7.2.0"
  }
}
