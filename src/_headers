# Response headers for static assets (SPEC §16.1). The build copies this file
# to dist/_headers; Wrangler reads it as config and never serves it. Limits:
# 100 rules and 2,000 characters a line. Wrangler doesn't check this file on
# deploy, so test/node/deploy-config.test.js does. Rules never apply to
# responses the Worker builds itself (/api/*, /admin).

# Keep every workers.dev address out of search results (SPEC §18.3): the
# preview and version URLs there (version URLs run on production's database;
# Cloudflare marks only preview URLs noindex itself), and production's own
# workers.dev address should workers_dev ever be on (off since 2026-11-10).
# It never matches the custom domain. Keep it after launch: preview_urls
# stays on (SPEC §18.2).
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

# The 404 page is also served at /404 with a 200 status, on every host.
/404
  X-Robots-Tag: noindex

# Security headers for every static response: pages, the 404 page, scripts,
# styles, icons and media (SPEC §16.1). Set each header here once: Cloudflare
# joins a header that two matching rules set with a comma, which for the CSP
# means two policies, both enforced. A rule for a sub-path that needs another
# value must detach it first with "! <Header>". The policy's other hosts are
# YouTube's IFrame API and player (src/js/players.js) and Turnstile
# (src/js/feedback.js); a test keeps them in step with the code.
# Referrer-Policy is YouTube's recommended value: never one that sends no
# Referer at all (SPEC §9.1, §16.1). HSTS has no includeSubDomains or preload.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.youtube.com https://challenges.cloudflare.com; frame-src https://www.youtube-nocookie.com https://challenges.cloudflare.com; img-src 'self'; connect-src 'self'; style-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
