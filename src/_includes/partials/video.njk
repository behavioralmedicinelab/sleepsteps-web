{#-
  VideoEmbed (SPEC §9.1, §15.1; HANDOFF §5, §7): the click-to-load facade,
  then the YouTube notice under it.

    {% from "partials/video.njk" import videoEmbed %}
    {% set video = problem_video | videoById(collections.videos) %}
    {{ videoEmbed(video, showTitle=true, bleed='page', arc=true) }}

  Arguments (keyword arguments, all optional after `video`):
    video      a video from `videoById` (or `introChapters`/`solutionsByTier`)
    showTitle  true: a title plate on the frame (use it where no heading
               nearby names the video, e.g. a problem's own video). false:
               the title is still the control's accessible name.
    bleed      'inset' (default): rounded frame inside the column.
               'page': below 600px the frame runs to the screen edges
               (cancels the page gutter). 'card': below 600px square corners
               to fill a card edge to edge (the card has no side padding).
    arc        true: the settling arc at the frame's base, from 600px, when
               the video has no thumbnail
    size       'md' (default): 72px play disc, 56px below 600px.
               'lg': 80px / 64px (Start here)

  The notice's sentences have the id video-notice-<video_id>, and the facade
  names it in aria-describedby, so the notice is heard with the play control
  although it comes after it (SPEC §9.1: pressing play is an informed choice).

  Without JavaScript the facade is a "Watch on YouTube" link. src/js/players.js
  turns it into a "Play video" button that loads the YouTube player only when
  pressed: nothing here contacts YouTube (no iframe, API script, preconnect or
  YouTube thumbnail). The frame shows the video's self-hosted thumbnail
  (media/thumbs/) if it has one, otherwise the plain night-teal frame.

  A placeholder video (`placeholder: true`) shows "[Video coming soon]" and
  has no link or button. Its notice is still shown, so the page reads as it
  will at launch.
-#}
{%- from "partials/icons.njk" import icon -%}
{%- from "notices/video.njk" import videoNotice -%}
{%- macro videoEmbed(video, showTitle=false, bleed='inset', arc=false, size='md') -%}
{%- set spoken = video.duration | spokenDuration -%}
{%- set noticeId = 'video-notice-' + video.video_id -%}
<div class="video video--{{ bleed }}{% if size == 'lg' %} video--lg{% endif %}{% if video.placeholder %} video--placeholder{% endif %}" data-video="{{ video.video_id }}"{% if not video.placeholder %} data-youtube-id="{{ video.youtube_id }}"{% endif %} data-title="{{ video.title }}">
  <div class="video__frame">
    {%- if video.thumbnail or arc %}
    <div class="video__media">
      {%- if video.thumbnail %}<img class="video__thumb" src="/media/thumbs/{{ video.thumbnail }}" alt="" width="1280" height="720" loading="lazy" decoding="async">
      {%- else %}{#- The boards' flatter video arc (Problem-A, Intro-B), not the hero's (partials/arc.njk). -#}
      <svg class="arc arc--video" viewBox="0 0 960 120" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 120 L0 80 Q480 10 960 80 L960 120 Z"/></svg>{% endif %}
    </div>
    {%- endif %}
    {%- if video.placeholder %}
    <div class="video__facade video__facade--placeholder">
      <span class="video__title{% if not showTitle %} visually-hidden{% endif %}">{{ video.title }}</span>
      <span class="video__soon">[Video coming soon]</span>
      <span class="duration-badge video__duration">{{ video.duration }}</span>
    </div>
    {%- else %}
    <a class="video__facade" href="https://www.youtube.com/watch?v={{ video.youtube_id }}" rel="noreferrer" aria-describedby="{{ noticeId }}">
      <span class="video__action visually-hidden">Watch on YouTube: </span>
      <span class="video__title{% if not showTitle %} visually-hidden{% endif %}">{{ video.title }}</span>
      <span class="play-disc" aria-hidden="true">{{ icon('play', 28, 'play-disc__icon') }}</span>
      <span class="duration-badge video__duration" aria-hidden="true">{{ video.duration }}</span>
      {%- if spoken %}<span class="visually-hidden">, {{ spoken }}</span>{% endif %}
    </a>
    {%- endif %}
  </div>
  {{ videoNotice(noticeId) }}
</div>
{%- endmacro -%}
