{#-
  Solutions on a problem page (HANDOFF §6.4 SolutionCard; board
  Problem-A.dc.html, phone Problem-Phone.dc.html; SPEC §7.2, §7.5).

    {% from "problem/solutions.njk" import solutionsSection %}
    {% set tiers = solutions | solutionsByTier(collections.videos) %}
    {% set ratingsOn = site.features.ratings === true %}
    {% if tiers.main.length %}{{ solutionsSection('main', tiers.main, page_id, ratingsOn) }}{% endif %}
    {% if tiers.extra.length %}{{ solutionsSection('extra', tiers.extra, page_id, ratingsOn) }}{% endif %}

  solutionsSection(tier, items, pageId, ratings)
    tier     'main' ("Main solutions", #main-solutions) or 'extra' ("Other
             things that can help", #more-solutions). The page omits a
             section with no items: the extra one when there are no extras,
             and both on a stand-alone problem (SPEC §7.2).
    items    tiers.main or tiers.extra from `solutionsByTier`; with none,
             the macro renders nothing (no heading without cards)
    pageId   the page's page_id (unused by the cards; kept so callers
             don't change)
    ratings  exactly true (the layout passes site.features.ratings ===
             true): renders each card's ratings widget and closed-card
             summary line (SPEC §12, partials/rating.njk)

  solutionCard(solution, pageId, ratings): one card, an <li> in the grid.

  Without JavaScript each card is a native <details name="solution">: the
  <summary> is the closed card (thumbnail band, step chip, duration, title,
  blurb), and opening it shows the video with its YouTube notice and the
  other formats. The shared `name` keeps one card open at a time across both
  sections where browsers support it; elsewhere several can be open, which is
  harmless. Cards start closed, so the first screen holds one video facade,
  not two; add `open` to a card's <details> to start it open, and
  src/js/solutions.js keeps it open.

  src/js/solutions.js turns each <details> into a <div>, its summary into an
  <h3> holding a <button aria-expanded aria-controls>, and the panel into a
  labelled region. It shows the parts marked `hidden` below that only work
  with it: the open card's header (step chip, Close, heading, blurb) and the
  quick "Transcript" link, which opens the card and its transcript. Opening a
  card closes any other, in either section, pausing its media.

  ids (unique per page; the validator allows each video once per page):
  solution-<video_id> on the card, plus -panel, -heading, -blurb, -length.
-#}
{%- from "partials/icons.njk" import icon -%}
{%- from "partials/step-chip.njk" import stepChip -%}
{%- from "partials/video.njk" import videoEmbed -%}
{%- from "partials/formats.njk" import formatLinks -%}
{%- from "partials/rating.njk" import rating, ratingStatus -%}

{%- macro solutionCard(solution, pageId, ratings=false) -%}
{%- set video = solution.video -%}
{%- set id = 'solution-' + video.video_id -%}
{%- set label = 'Main' if solution.tier == 'main' else 'Extra' -%}
{%- set spoken = video.duration | spokenDuration -%}
{%- set ratingsOn = ratings === true -%}
<li class="solution solution--{{ solution.tier }}" id="{{ id }}">
  <details class="solution__disclosure" name="solution">
    <summary class="solution__face"><span class="solution__face-inner">
      <span class="solution__band" aria-hidden="true">
        {%- if video.thumbnail %}<img class="solution__thumb" src="/media/thumbs/{{ video.thumbnail }}" alt="" width="1280" height="720" loading="lazy" decoding="async">{% endif %}
        <span class="play-disc play-disc--sm">{{ icon('play', 20) }}</span>
        {{ stepChip(solution.n, label, variant='sm paper') }}
        <span class="duration-badge solution__duration">{{ video.duration }}</span>
      </span>
      <span class="solution__disc" aria-hidden="true">{{ solution.n }}</span>
      <span class="solution__text">
        <span class="solution__title">{{ video.title }}</span>
        <span class="solution__blurb" id="{{ id }}-blurb">{{ solution.blurb }}</span>
        <span class="solution__length visually-hidden" id="{{ id }}-length">Video{% if spoken %}, {{ spoken }}{% endif %}</span>
      </span>
      <span class="solution__chevron" aria-hidden="true">{{ icon('chevron-down', 18) }}</span>
    </span></summary>
    <div class="solution__panel" id="{{ id }}-panel">
      {#- The open card's header: shown by solutions.js from 600px. Without
          JavaScript the summary above stays visible and names the card. #}
      <div class="solution__header" hidden>
        <div class="solution__header-row">
          {{ stepChip(solution.n, label, variant='sm') }}
          <button type="button" class="solution__close" aria-expanded="true" aria-controls="{{ id }}-panel">Close<span class="visually-hidden"> {{ video.title }}</span></button>
        </div>
        <h3 class="solution__heading" id="{{ id }}-heading" tabindex="-1">{{ video.title }}</h3>
        <p class="solution__lede">{{ solution.blurb }}</p>
      </div>
      <div class="solution__video">
        {{ videoEmbed(video, bleed='card') }}
      </div>
      {#- The ratings widget (SPEC §12), then the formats. The block is left
          out when it would be empty, and holding only the widget it ships
          hidden for rating.js to reveal (nothing to show without
          JavaScript). `| length`: a trimmed macro result is a SafeString
          object, truthy even when empty. #}
      {%- set formatsHtml = formatLinks(video) %}
      {%- set hasFormats = formatsHtml | trim | length %}
      {%- if ratingsOn or hasFormats %}
      <div class="solution__tools"{% if not hasFormats %} hidden data-rating-reveal{% endif %}>
        {%- if ratingsOn %}
        {{ rating(video, 'card') }}
        {%- endif %}
        {%- if hasFormats %}
        {{ formatsHtml }}
        {%- endif %}
      </div>
      {%- endif %}
    </div>
  </details>
  <div class="solution__meta">
    {#- "You rated this n of 5." once a rating is accepted (rating.js);
        empty and hidden until then, and without JavaScript. #}
    {%- if ratingsOn %}
    {{ ratingStatus(video) }}
    {%- endif %}
    {%- if video.hasTranscript or video.handout %}
    <ul class="solution__quick" role="list">
      {%- if video.hasTranscript %}
      {#- Hidden without JavaScript: a link into a closed card does nothing.
          players.js handles the click and solutions.js opens the card. #}
      <li class="solution__quick-transcript" hidden><a href="#transcript-{{ video.video_id }}">Transcript<span class="visually-hidden">: {{ video.title }}</span></a></li>
      {%- endif %}
      {%- if video.handout %}
      <li><a href="/media/pdf/{{ video.handout }}" type="application/pdf" data-handout="{{ video.video_id }}">Handout<span class="visually-hidden">: {{ video.title }} (PDF)</span></a></li>
      {%- endif %}
    </ul>
    {%- endif %}
  </div>
</li>
{%- endmacro -%}

{%- macro solutionsSection(tier, items, pageId, ratings=false) -%}
{%- if items and items.length -%}
{%- if tier == 'main' -%}
  {%- set sectionId = 'main-solutions' -%}
  {%- set eyebrow = 'Things to try' -%}
  {%- set heading = 'Main solutions' -%}
  {%- set intro = 'Most people start here. Pick the one that sounds most doable for you.' -%}
{%- else -%}
  {%- set sectionId = 'more-solutions' -%}
  {%- set eyebrow = 'If you want more' -%}
  {%- set heading = 'Other things that can help' -%}
  {%- set intro = 'Useful extras, or for when the main ideas aren’t quite enough.' -%}
{%- endif %}
<section class="solutions solutions--{{ tier }}" id="{{ sectionId }}" aria-labelledby="{{ sectionId }}-title">
  <div class="solutions__head">
    <div>
      <p class="eyebrow solutions__eyebrow">{{ eyebrow }}</p>
      <h2 class="section-heading" id="{{ sectionId }}-title">{{ heading }}</h2>
    </div>
    <p class="solutions__intro">{{ intro }}</p>
  </div>
  <ol class="solution-grid" role="list">
    {%- for solution in items %}
    {{ solutionCard(solution, pageId, ratings) }}
    {%- endfor %}
  </ol>
</section>
{%- endif -%}
{%- endmacro -%}
