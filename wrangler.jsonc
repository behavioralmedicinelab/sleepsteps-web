{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker in Cloudflare must have exactly this name, or Workers Builds
  // fails or deploys under the dashboard's name (SPEC §18.3).
  "name": "sleepsteps",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker answers every /api/*, /admin and /admin/* request, even one
    // whose path matches a file (SPEC §14.4, §18.2). Both admin entries are
    // needed: "/admin/*" doesn't match "/admin".
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  // Workers Logs off: invocation logs record request metadata, which the API
  // must not store (SPEC §14.1). `wrangler tail` still shows live logs.
  "observability": { "enabled": false },
  // Production answers only on its custom domain, sleepsteps.org, since
  // 2026-11-10 (SPEC §18.2, §18.3). preview_urls stays on: version URLs keep
  // noindex from dist/_headers (SPEC §16.1), and the API and admin pages
  // refuse them (API_HOSTS below).
  "workers_dev": false,
  "preview_urls": true,
  // Production. Never add "remote": true to a binding: local development and
  // tests must not reach the real database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sleepsteps",
      "database_id": "7da77651-1695-4331-8708-114382f04757",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Cloudflare Access, for the Worker's own check of the admin pages' token
    // (worker/lib/access-jwt.js, SPEC §14.4): the team's domain with no
    // scheme, and the AUD tag (64 hex characters) of the self-hosted
    // application on sleepsteps.org, whose only policy is "data access"
    // (SPEC §18.4 step 6d, set 2026-11-10). The "<AUD_TAG>" placeholder
    // would refuse every admin request and fetch nothing.
    "ACCESS_TEAM_DOMAIN": "hidden-bird-3278.cloudflareaccess.com",
    "ACCESS_AUD": "38a47652fa0686b23bf88e04009c11112088c06a70401615bebc4275f9c92242",
    // The API stores nothing unless this is exactly "on" (SPEC §11). On in
    // production since 2026-11-10, for the team's testing while the whole
    // domain is behind Cloudflare Access; the test rows are deleted before
    // the site goes public, after the privacy officer's go-ahead (SPEC §18.3).
    "DATA_COLLECTION": "on",
    // The hosts the API and the admin pages answer on, comma-separated; `*`
    // matches within one DNS label (worker/lib/hosts.js). Only the custom
    // domain, siteUrl's host, so version URLs never match (SPEC §14.1, §14.4,
    // §18.2, §18.3). Every host listed here must be behind an Access
    // application covering /admin and /admin/*.
    "API_HOSTS": "sleepsteps.org"
  },
  // Secrets (set with `wrangler secret put`, never committed): TURNSTILE_SECRET,
  // for /api/feedback's Turnstile check (SPEC §14.3). Without it, feedback
  // answers 500 once collection is on. Locally, `npm run dev:collect` passes
  // Cloudflare's published always-pass test secret with --var. There is no
  // `secrets.required` list: Wrangler would then fail every build and deploy
  // until a person had set the secret.
  //
  // Worker Previews (every branch but main, built by Workers Builds with
  // `npx wrangler preview`). Previews inherit no vars or bindings from above,
  // so each one is repeated here; `assets`, `compatibility_date` and `main`
  // come from the top level. Preview secrets are set with
  // `wrangler preview base-config secret put`. D1 migrations for the preview
  // database use wrangler.preview-migrations.jsonc, because `wrangler d1`
  // commands read only the top-level d1_databases (SPEC §17, §18.2).
  // https://developers.cloudflare.com/workers/previews/configuration/
  "previews": {
    // Not inherited from the top level either.
    "observability": { "enabled": false },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "sleepsteps-preview",
        "database_id": "38b5ff0a-4518-4aa0-b884-c93546b9ee56"
      }
    ],
    "vars": {
      // The same team; the AUD is the Worker-level Access application's
      // ("Previews only", or "All traffic" before launch), not the /admin
      // application's: on preview hosts the Worker-level one applies (set up
      // 2026-11-07, "Previews only" with the "preview reviewers" policy).
      "ACCESS_TEAM_DOMAIN": "hidden-bird-3278.cloudflareaccess.com",
      "ACCESS_AUD": "d8932384b2963f4439782139eff4a0222999d5abf671e52600139308bd9991ea",
      // Off in previews: preview writes share the account's D1 limits with
      // production, and turning it on is a separate decision (SPEC §21).
      "DATA_COLLECTION": "off",
      // Every preview URL, <branch>-sleepsteps.<subdomain>.workers.dev
      // (SPEC §18.3), for the API and the admin pages. Only previews read
      // this block, so production's version URLs, which look the same, still
      // answer 404 (API) and 403 (admin).
      "API_HOSTS": "*-sleepsteps.*.workers.dev"
    }
  }
}
